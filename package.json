  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.1",
    "three": "^0.164.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SSC-STUDIO/Zenith-Tabletop-3D.git"
