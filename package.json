  "description": "Zenith Tabletop 3D — immersive Gomoku with diegetic controls, AI, replay and saved sessions",
  "private": true,
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "serve": "node tools/serve.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node tools/smoke.mjs",
    "perf": "node tools/perf.mjs",
    "assets": "node tools/fetch-assets.mjs",
    "test:features": "node tools/features.mjs",
    "test:production": "node tools/production-smoke.mjs",
    "video:capture": "node tools/promo/capture.mjs",
    "video:encode": "node tools/promo/encode.mjs",
    "video:verify": "node tools/promo/verify.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "node tools/android/build.mjs"
